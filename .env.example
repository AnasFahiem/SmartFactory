# Python camera backend
API_URL=https://smartest-factory-dcg4awhecvahcmgq.francecentral-01.azurewebsites.net/api/camera/upload
CAMERA_SECRET=dev-camera-secret
CAMERA_SOURCE=0

# ASP.NET uses appsettings, user-secrets, or real environment variables.
# Equivalent environment variable names use double underscores:
# ConnectionStrings__DefaultConnection=Server=localhost;Database=IotDb;User=root;Password=your_password;
# DefaultAdmin__Username=admin
# DefaultAdmin__Password=change-this-admin-password
# Camera__SecretKey=change-this-local-secret
# Auth__SessionMinutes=480
# Mqtt__CommandTopic=factory/commands
# Mqtt__WeightRequestIntervalSeconds=6

# Optional email/MQTT settings for scripts/ai_dashboard_monitor.py
MQTT_BROKER=your-broker.example.com
MQTT_PORT=8883
MQTT_USER=your-mqtt-user
MQTT_PASS=your-mqtt-password
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_RECEIVER=alerts@example.com
